<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#C0000000"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stretchColumns="1">

        <TableRow android:layout_marginBottom="8dp">
            <TextView
                android:layout_gravity="center_vertical"
                android:paddingRight="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:text="Red from" />
            <Spinner
                android:id="@+id/redSourceSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <TextView
                android:layout_gravity="center_vertical"
                android:paddingRight="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:text="Green from" />
            <Spinner
                android:id="@+id/greenSourceSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <TextView
                android:layout_gravity="center_vertical"
                android:paddingRight="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:text="Blue from" />
            <Spinner
                android:id="@+id/blueSourceSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </TableRow>
    </TableLayout>

    <CheckBox
        android:id="@+id/flipHueCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingLeft="8dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="Flip hue" />

    <Button
        android:id="@+id/doneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:minWidth="120dp"
        android:minHeight="48dp"
        android:textSize="16sp"
        android:text="Done" />

</LinearLayout>
