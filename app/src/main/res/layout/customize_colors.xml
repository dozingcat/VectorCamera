<?xml version="1.0" encoding="utf-8"?>
<!-- Panel for the custom colors effect. The four corner swatches are the gradient's corner
     colors, in the same positions as on screen; the background color, mode, and Done button
     sit in the middle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#C0000000"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/topLeftColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentLeft="true"
            android:contentDescription="Top left color" />

        <View
            android:id="@+id/topRightColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:contentDescription="Top right color" />
    </RelativeLayout>

    <!-- The margins keep the background swatch clear of the corner swatch columns. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="52dp"
        android:layout_marginRight="52dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="Background" />

        <View
            android:id="@+id/backgroundColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:contentDescription="Background color" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/solidCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="48dp"
        android:paddingLeft="8dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="Solid" />

    <Button
        android:id="@+id/doneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minWidth="120dp"
        android:minHeight="48dp"
        android:textSize="16sp"
        android:text="Done" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <View
            android:id="@+id/bottomLeftColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentLeft="true"
            android:contentDescription="Bottom left color" />

        <View
            android:id="@+id/bottomRightColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:contentDescription="Bottom right color" />
    </RelativeLayout>

</LinearLayout>
